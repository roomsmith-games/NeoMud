# ─── Stage 1: Build ───────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

# Copy package files + prisma schema (postinstall runs prisma generate)
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci

# Copy remaining source
COPY . .

# Build-time config for same-origin hosting at stage.neomud.app/maker.
# VITE_BASE controls Vite's asset base (HTML references /maker/assets/*).
# VITE_API_BASE controls the path prefix used by src/api.ts so the SPA
# calls /maker-api/* (which Caddy rewrites back to /api/*).
ARG VITE_BASE=/maker/
ARG VITE_API_BASE=/maker-api
ENV VITE_BASE=$VITE_BASE
ENV VITE_API_BASE=$VITE_API_BASE

# Build React frontend (Prisma client already generated by postinstall)
RUN npm run build

# ─── Stage 2: Runtime ─────────────────────────────────────
FROM node:22-alpine

# Install wget for health checks
RUN apk add --no-cache wget

# Use the existing 'node' user (UID 1000) from node:22-alpine

WORKDIR /app

# Copy everything needed from build stage (tsx requires devDeps at runtime)
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/prisma ./prisma
# Prisma 7.7+ requires prisma.config.ts at runtime for `db push` (used by
# createProject to initialize new per-user SQLite DBs). Without it the CLI
# errors "The datasource.url property is required in your Prisma config
# file when using prisma db push." The config reads DATABASE_URL from
# process.env, which createProject sets via execSync env.
COPY --from=build /app/prisma.config.ts ./

# Create directories for persistent data
RUN mkdir -p /app/projects /app/seed && chown -R node:node /app

# Volumes for persistent data and world bundle
VOLUME ["/app/projects", "/app/seed"]

# Port
EXPOSE 3001

# Environment defaults
ENV NODE_ENV=production
ENV MAKER_PORT=3001
ENV MAKER_PROJECTS_DIR=/app/projects
ENV NEOMUD_DEFAULT_WORLD=/app/seed/default-world.nmd

# Health check
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -q --spider http://localhost:3001/ || exit 1

# Run as non-root
USER node

# tsx runs TypeScript server directly (same as `npm run server`)
CMD ["npx", "tsx", "server/index.ts"]
